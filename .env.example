# Copie para .env e preencha. O arquivo .env não vai para o git nem para a imagem.

# Obrigatório: mínimo de 32 caracteres. Gere com:  openssl rand -hex 32
# Assina o CSRF da equipe.
CHECKIN_SESSION_SECRET=

# Obrigatório: mínimo de 32 caracteres, diferente do anterior. Gere com:  openssl rand -hex 32
# CPF e e-mail ficam guardados só como chave calculada com este segredo. Guarde-o junto dos
# backups (mas não no mesmo lugar que eles): se ele se perder ou mudar, a busca pública deixa
# de reconhecer as inscrições e é preciso reimportar a lista original.
CHECKIN_LOOKUP_SECRET=

# Endereço público. Com https://, os cookies exigem conexão segura e o navegador passa a usar
# só HTTPS neste endereço. Deixe comentado para experimentar em http://127.0.0.1:8000.
# CHECKIN_PUBLIC_URL=https://checkin.seu-dominio.br

# Domínio do site (perfis "https" e "https-interno").
# CHECKIN_DOMAIN=checkin.seu-dominio.br

# --- HTTPS feito por um proxy de outra máquina (ex.: o da instituição) ---
# IP(s) do proxy, separados por espaço. Só deles se aceita o IP original de quem acessou.
# Com um proxy nginx/Caddy nesta mesma máquina, use o gateway do Docker: 172.31.250.1
# CHECKIN_PROXY_IPS=10.0.0.1
# Perfil "https-interno" (o proxy repassa em HTTPS para a porta 443 desta máquina):
# IP desta máquina que o proxy alcança (veja com: ip -br -4 addr).
# CHECKIN_SERVER_IP=10.0.0.10
# Sem perfil de Caddy (o proxy repassa em HTTP): IP e porta em que a aplicação fica acessível.
# CHECKIN_BIND=10.0.0.10
# CHECKIN_PORT=8000

# --- Limites de tentativas: "quantidade/minutos" ---
# CHECKIN_LIMIT_SEARCH=60/1           # buscas na página pública por IP
# CHECKIN_LIMIT_SEARCH_MISS=20/10     # buscas sem resultado por IP (quem testa CPFs ao acaso)
# CHECKIN_LIMIT_LOGIN_IP=20/5         # senhas erradas por IP
# CHECKIN_LIMIT_LOGIN_USER=10/15      # senhas erradas por conta da equipe
# CHECKIN_ALERT_SEARCH_MISS=30/10     # alerta no painel: buscas sem resultado, de todas as origens

# Rede interna do compose; mude só se conflitar com outra rede da máquina.
# O IP do Caddy precisa estar dentro dela.
# CHECKIN_DOCKER_SUBNET=172.31.250.0/24
# CHECKIN_CADDY_IP=172.31.250.10

# Cópia no Google Sheets (opcional).
# CHECKIN_SHEETS_URL=
# CHECKIN_SHEETS_SECRET=
