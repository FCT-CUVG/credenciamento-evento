# Copie para .env e preencha. O arquivo .env não vai para o git nem para a imagem.

# Obrigatório: mínimo de 32 caracteres. Gere com:  openssl rand -hex 32
# Se mudar, todos da equipe precisam entrar de novo.
CHECKIN_SESSION_SECRET=

# Endereço público. Com https://, os cookies passam a exigir conexão segura.
# Deixe comentado para experimentar em http://127.0.0.1:8000.
# CHECKIN_PUBLIC_URL=https://credenciamento.seu-dominio.org

# Domínio do HTTPS automático (perfil "https" do compose, com Caddy).
# CHECKIN_DOMAIN=credenciamento.seu-dominio.org

# Porta local da aplicação (só em 127.0.0.1). Padrão: 8000.
# CHECKIN_PORT=8000

# Rede interna do compose; mude só se conflitar com outra rede da máquina.
# CHECKIN_DOCKER_SUBNET=172.31.250.0/24

# Cópia no Google Sheets (opcional).
# CHECKIN_SHEETS_URL=
# CHECKIN_SHEETS_SECRET=
